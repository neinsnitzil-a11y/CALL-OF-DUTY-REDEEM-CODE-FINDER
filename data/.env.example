# CODM Redemption Hunter — local settings. The setup wizard fills these in for you.
# This file stays on your PC and is ignored by git. Never put passwords here.

# Your CODM Player UID (in-game: profile → the long number under your avatar). NOT a password.
CODM_UID=

# Which version you play: Global, Garena or Both
ACCOUNT_REGION=Both

# Official CODM Redemption Center (Global). Open it once to check it before enabling redemption.
REDEMPTION_URL_GLOBAL=https://www.callofduty.com/redemption
# Garena codes are usually redeemed inside the game; leave blank unless your region has a page.
REDEMPTION_URL_GARENA=

# chrome (Google Chrome), msedge (Microsoft Edge) or chromium (Playwright's own browser)
BROWSER_CHANNEL=chrome

# Optional: Discord webhook pinged when new READY codes appear
DISCORD_WEBHOOK_URL=

# Optional: per-game Discord channels (blank = use DISCORD_WEBHOOK_URL). Set these in
# ⚙ Settings → Games & Discord, e.g. DISCORD_WEBHOOK_WARZONE=, DISCORD_WEBHOOK_BO7=, DISCORD_WEBHOOK_MW4=
# Expired / used-up updates for all games (blank = each game's own channel)
DISCORD_UPDATES_WEBHOOK=
# App alerts: scanner started/stopped, sites blocking, redemption paused, Discord errors
DISCORD_WEBHOOK_SYSTEM=

# Optional AI helper (any provider). Set these on the 🤖 AI helper page.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Phone push (free ntfy app): set on Setup → Phone push
NTFY_TOPIC=
NTFY_SERVER=
# Optional: GitHub token (Issues: read & write on your community repo) to submit / vote in the app
GITHUB_TOKEN=
# Language: en, es, pt, id, hi, fr, de, ar, tr (others via AI)
APP_LANGUAGE=
